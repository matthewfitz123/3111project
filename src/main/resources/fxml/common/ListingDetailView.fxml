<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hkust.marketplace.controllers.common.ListingDetailController"
            prefWidth="1200" prefHeight="780">
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="12">
            <Button text="← Back" onAction="#goBack" styleClass="btn-outline, btn-sm"/>
            <Label text="Listing Detail" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="viewerLabel" text="" style="-fx-text-fill: #5a5a7a; -fx-font-size: 13px;"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="16" style="-fx-padding: 20;">

                <!-- header card with the important info and the buttons -->
                <VBox styleClass="card" spacing="10">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="typeBadge" text="For Sale" styleClass="badge"/>
                        <Label fx:id="statusBadge" text="Live" styleClass="badge"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="viewCountLabel" text="Views: 0"
                               style="-fx-text-fill: #9aa0b0; -fx-font-size: 12px;"/>
                    </HBox>
                    <Label fx:id="titleLabel" text="Listing title" wrapText="true"
                           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a2e;"/>
                    <Label fx:id="priceLabel" text="" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #003974;"/>
                    <Label fx:id="metaLabel" text="" wrapText="true" style="-fx-text-fill: #5a5a7a;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="actionButton" text="Make Offer" onAction="#handlePrimaryAction" styleClass="btn-primary"/>
                        <Button fx:id="chatButton" text="Chat" onAction="#openChat" styleClass="btn-outline"/>
                        <Button fx:id="reportButton" text="Report Listing" onAction="#reportListing"
                                styleClass="btn-outline"/>
                    </HBox>
                    <Label fx:id="actionHintLabel" text="" wrapText="true"
                           style="-fx-text-fill: #9aa0b0; -fx-font-size: 12px;"/>
                </VBox>

                <!-- every uploaded photo, up to six from the create form -->
                <VBox styleClass="card" spacing="10">
                    <Label text="Photos" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #003974;"/>
                    <FlowPane fx:id="photoGallery" hgap="10" vgap="10"/>
                </VBox>

                <VBox styleClass="card" spacing="8">
                    <Label text="Description" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #003974;"/>
                    <Label fx:id="descriptionLabel" text="" wrapText="true" style="-fx-text-fill: #3a3a55;"/>
                </VBox>

                <VBox styleClass="card" spacing="12">
                    <Label text="Item details" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #003974;"/>
                    <GridPane hgap="32" vgap="9">
                        <Label text="Category" style="-fx-text-fill: #5a5a7a; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="detailCategory" text="-" style="-fx-text-fill: #1a1a2e;"
                               GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label text="Condition" style="-fx-text-fill: #5a5a7a; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="detailCondition" text="-" style="-fx-text-fill: #1a1a2e;"
                               GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label text="Type" style="-fx-text-fill: #5a5a7a; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="detailType" text="-" style="-fx-text-fill: #1a1a2e;"
                               GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label text="Meet-up" style="-fx-text-fill: #5a5a7a; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label fx:id="detailMeetup" text="-" style="-fx-text-fill: #1a1a2e;"
                               GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        <Label text="Status" style="-fx-text-fill: #5a5a7a; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                        <Label fx:id="detailStatus" text="-" style="-fx-text-fill: #1a1a2e;"
                               GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                        <Label text="Posted" style="-fx-text-fill: #5a5a7a; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                        <Label fx:id="detailPosted" text="-" style="-fx-text-fill: #1a1a2e;"
                               GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                        <Label fx:id="lendingLabel" text="Lending duration" style="-fx-text-fill: #5a5a7a; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                        <Label fx:id="lendingValue" text="-" style="-fx-text-fill: #1a1a2e;"
                               GridPane.columnIndex="1" GridPane.rowIndex="6"/>
                        <Label text="Views" style="-fx-text-fill: #5a5a7a; -fx-font-size: 12px;"
                               GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                        <Label fx:id="detailViews" text="0" style="-fx-text-fill: #1a1a2e;"
                               GridPane.columnIndex="1" GridPane.rowIndex="7"/>
                    </GridPane>
                </VBox>

                <VBox styleClass="card" spacing="10">
                    <Label text="Seller" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #003974;"/>
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Label fx:id="sellerAvatar" text="?"
                               style="-fx-background-color: #003974; -fx-background-radius: 24; -fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-min-width: 48; -fx-min-height: 48; -fx-alignment: center;"/>
                        <VBox spacing="2">
                            <Label fx:id="sellerNameLabel" text="Seller name"
                                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                            <Label fx:id="sellerUsernameLabel" text=""
                                   style="-fx-text-fill: #5a5a7a; -fx-font-size: 12px;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label fx:id="sellerRatingStars" text=""
                                   style="-fx-text-fill: #A68137; -fx-font-size: 16px;"/>
                            <Label fx:id="sellerRatingCountLabel" text=""
                                   style="-fx-text-fill: #9aa0b0; -fx-font-size: 11px;"/>
                        </VBox>
                    </HBox>
                    <Label fx:id="sellerBioLabel" text="" wrapText="true"
                           style="-fx-text-fill: #5a5a7a; -fx-font-size: 13px;"/>
                    <VBox fx:id="sellerReviewsBox" spacing="8"/>
                </VBox>

                <!-- step 14 chat panel, scoped to this listing -->
                <fx:include fx:id="chatPanel" source="ChatPanelView.fxml"/>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
