<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hkust.marketplace.controllers.common.ChatPanelController"
      styleClass="card" spacing="10">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Chat" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #003974;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="chatHint" text="" wrapText="true"
               style="-fx-text-fill: #9aa0b0; -fx-font-size: 11px;"/>
    </HBox>

    <HBox spacing="6" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search this chat..." HBox.hgrow="ALWAYS"
                   onAction="#handleSearch"/>
        <Button text="Search" onAction="#handleSearch" styleClass="btn-outline, btn-sm"/>
        <Button text="Clear" onAction="#clearSearch" styleClass="btn-outline, btn-sm"/>
    </HBox>

    <ScrollPane fx:id="messageScroll" fitToWidth="true" prefHeight="210"
                style="-fx-background-color: transparent;">
        <VBox fx:id="messageList" spacing="7" style="-fx-padding: 4;"/>
    </ScrollPane>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <TextField fx:id="messageField" promptText="Write a message..." HBox.hgrow="ALWAYS"
                   onAction="#sendMessage"/>
        <Button fx:id="sendButton" text="Send" onAction="#sendMessage" styleClass="btn-primary, btn-sm"/>
        <Button fx:id="makeOfferButton" text="Make Offer" disable="true" styleClass="btn-outline, btn-sm"/>
    </HBox>
</VBox>
