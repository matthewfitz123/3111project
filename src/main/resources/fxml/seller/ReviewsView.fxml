<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hkust.marketplace.controllers.seller.ReviewsController"
      spacing="12" style="-fx-padding: 4;">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Reviews &amp; Feedback" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="summaryLabel" text=""
               style="-fx-text-fill: #A68137; -fx-font-weight: bold;"/>
    </HBox>
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox fx:id="reviewList" spacing="10" style="-fx-padding: 4;"/>
    </ScrollPane>
</VBox>
